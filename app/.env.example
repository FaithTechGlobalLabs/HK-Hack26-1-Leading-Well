# Copy to .env.local. Leave values empty to run in offline demo mode (local JSON store + mocked AI).

# Supabase (Postgres + pgvector + magic-link auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (required in Supabase mode): survey submissions and seed scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (gpt-4.1-mini + text-embedding-3-small). Empty = deterministic mock.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Public site URL used in survey share links / QR codes (optional).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode only: path to the local JSON store (defaults to .data/demo-db.json, os.tmpdir() on Vercel).
DEMO_DATA_FILE=

# Force mocked AI even when OPENAI_API_KEY is set (tests/demos).
MOCK_AI=
